<mujoco model="kitchen_counter">
  <!-- ROSCon teleop workcell derived from Text2MuJoCo showcase
       `01-button-cube-box` (MIT): workbench, start button, open place-box.
       SO-101 + calibrated cameras replace their industrial arm.
       Table top is z=0 so existing IK / front-top-wrist poses still hold.
       Graspables are primitive geoms (no scan meshes) so they stay smooth. -->
  <include file="../../so101_new_calib.xml"/>

  <option timestep=".001" noslip_iterations="20" noslip_tolerance="1e-6">
    <flag contact="enable" override="enable"/>
  </option>

  <default>
    <geom friction="0.8 0.01 0.001" solimp="0.98 0.999 0.0005" solref="0.01 1"/>
    <default class="world_part">
      <geom contype="1" conaffinity="7"/>
    </default>
    <default class="visual_only">
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
  </default>

  <statistic center="0.20 0.12 0.12" extent="1.1"/>

  <visual>
    <headlight ambient="0.28 0.28 0.30" diffuse="0.70 0.70 0.68" specular="0.15 0.15 0.15"/>
    <global azimuth="20" elevation="-25" offheight="720" offwidth="1280"/>
    <quality offsamples="8" shadowsize="2048"/>
    <map znear="0.01" zfar="10"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.22 0.24 0.28" rgb2="0.02 0.02 0.03" width="32" height="512"/>
    <texture name="ground_texture" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.15 0.17 0.20" rgb2="0.25 0.27 0.30"/>
    <material name="ground_material" texture="ground_texture" texrepeat="4 4" reflectance="0.08"/>
    <material name="table_material" rgba="0.55 0.57 0.60 1" specular="0.15" roughness="0.70"/>
    <material name="red_material" rgba="0.90 0.04 0.04 1" specular="0.30" roughness="0.35"/>
    <material name="green_material" rgba="0.04 0.75 0.12 1" specular="0.25" roughness="0.40"/>
    <material name="blue_material" rgba="0.08 0.32 0.85 0.72" specular="0.20" roughness="0.45"/>
    <material name="blue_front_material" rgba="0.08 0.32 0.85 0.18" specular="0.10" roughness="0.55"/>
    <material name="blue_part_material" rgba="0.02 0.32 0.95 1" specular="0.42" roughness="0.24"/>
    <material name="dark_material" rgba="0.09 0.10 0.12 1"/>
  </asset>

  <worldbody>
    <!-- Same calibrated cameras as simple_pick (policy / teleop) -->
    <camera name="top" pos="0.05 0.26 0.42" quat="-0.535362 -0.133481 0.201765 0.809235" fovy="60"/>
    <camera name="front" pos="0.3200 0.4000 0.2600" quat="0.138452 0.058333 0.383862 0.911086" fovy="65"/>
    <!-- Teleop GLFW only (4th pane uses overview). Not recorded unless listed in
         robot.camera_names. Extra overview_* cams are MJCF helpers / unused by default. -->
    <camera name="overview" pos="0.950 1.100 0.780" quat="0.274720 0.156617 0.469850 0.824161" fovy="55"/>
    <camera name="overview_front" pos="0.220 1.200 0.520" quat="0.007236 0.004821 0.554445 0.832175" fovy="55"/>
    <camera name="overview_side" pos="1.250 0.180 0.480" quat="0.559149 0.375268 0.411975 0.613843" fovy="50"/>
    <camera name="overview_top" pos="0.200 0.140 1.550" quat="1.000000 0.000000 0.000000 0.000000" fovy="60"/>

    <light name="key_light" pos="-1.2 -1.0 2.8" dir="0.35 0.35 -1" directional="true" castshadow="true"/>
    <light name="fill_light" pos="1.2 -0.2 1.8" dir="-0.7 0.15 -1" directional="true"
           diffuse="0.35 0.38 0.45" specular="0.05 0.05 0.05"/>

    <!-- Floor 75 cm below the bench top (Text2MuJoCo 01 table height). -->
    <geom name="ground_geom" class="world_part" type="plane" size="2.5 2.5 0.1" pos="0 0 -0.75"
          material="ground_material"/>

    <!-- Workbench: Text2MuJoCo 01 table, top face at z=0, XY covering the SO-101 mount. -->
    <body name="table" pos="0.20 0.12 0">
      <geom name="table_geom" class="world_part" type="box" size="0.55 0.42 0.018" pos="0 0 -0.018"
            material="table_material"/>
      <geom name="table_leg_fl" class="world_part" type="box" pos="-0.48 -0.36 -0.393"
            size="0.032 0.032 0.357" material="dark_material"/>
      <geom name="table_leg_fr" class="world_part" type="box" pos="0.48 -0.36 -0.393"
            size="0.032 0.032 0.357" material="dark_material"/>
      <geom name="table_leg_bl" class="world_part" type="box" pos="-0.48 0.36 -0.393"
            size="0.032 0.032 0.357" material="dark_material"/>
      <geom name="table_leg_br" class="world_part" type="box" pos="0.48 0.36 -0.393"
            size="0.032 0.032 0.357" material="dark_material"/>
    </body>

    <!-- Start button (Text2MuJoCo 01 housing + cap, static, SO-101 scale). -->
    <body name="button_base" pos="0.12 0.24 0">
      <geom name="button_base_geom" class="world_part" type="cylinder" pos="0 0 0.005"
            size="0.028 0.005" material="dark_material"/>
      <geom name="button_bezel_left" class="world_part" type="box" pos="-0.026 0 0.016"
            size="0.005 0.030 0.011" material="dark_material"/>
      <geom name="button_bezel_right" class="world_part" type="box" pos="0.026 0 0.016"
            size="0.005 0.030 0.011" material="dark_material"/>
      <geom name="button_bezel_front" class="world_part" type="box" pos="0 -0.026 0.016"
            size="0.021 0.005 0.011" material="dark_material"/>
      <geom name="button_bezel_back" class="world_part" type="box" pos="0 0.026 0.016"
            size="0.021 0.005 0.011" material="dark_material"/>
      <geom name="start_button_geom" class="world_part" type="cylinder" pos="0 0 0.022"
            size="0.020 0.008" material="green_material"/>
    </body>

    <!-- Place target: Text2MuJoCo 01 open box (~0.4 scale), translucent camera-side wall. -->
    <body name="target_box" pos="0.08 0.10 0">
      <geom name="box_bottom" class="world_part" type="box" pos="0 0 0.004"
            size="0.072 0.060 0.004" material="blue_material"/>
      <geom name="box_left" class="world_part" type="box" pos="-0.068 0 0.044"
            size="0.004 0.060 0.036" material="blue_material"/>
      <geom name="box_right" class="world_part" type="box" pos="0.068 0 0.044"
            size="0.004 0.060 0.036" material="blue_material"/>
      <geom name="box_front" class="world_part" type="box" pos="0 -0.056 0.044"
            size="0.064 0.004 0.036" material="blue_front_material"/>
      <geom name="box_back" class="world_part" type="box" pos="0 0.056 0.044"
            size="0.064 0.004 0.036" material="blue_material"/>
    </body>

    <!-- Lab cube (joint name `block` so existing robot helpers still resolve). -->
    <body name="block" pos="0.30 0.18 0.015">
      <freejoint name="block"/>
      <geom name="block" type="box" size=".015 .015 .015" mass="0.05"
            rgba="0.15 0.85 0.20 1" friction="2 0.01 0.0001" solimp="0.95 0.95 0.001"
            solref="0.02 1" margin="0.003" condim="4"/>
    </body>

    <!-- Extra Text2MuJoCo-style payloads, sized for the SO-101 jaw. -->
    <body name="red_cube" pos="0.24 0.24 0.012">
      <freejoint name="red_cube"/>
      <geom name="red_cube_geom" type="box" size="0.012 0.012 0.012" mass="0.04"
            material="red_material" friction="2 0.01 0.0001" solimp="0.95 0.95 0.001"
            solref="0.02 1" margin="0.003" condim="4"/>
    </body>
    <body name="blue_part" pos="0.34 0.12 0.016">
      <freejoint name="blue_part"/>
      <geom name="blue_part_geom" type="cylinder" size="0.013 0.016" mass="0.04"
            material="blue_part_material" friction="2 0.01 0.0001" solimp="0.95 0.95 0.001"
            solref="0.02 1" margin="0.003" condim="4"/>
    </body>

    <body name="target" pos="0.2 0.15 .3" quat="0 1 0 0" mocap="true">
      <geom name="target" type="box" size=".03 .03 .03" contype="0" conaffinity="0" rgba=".6 .3 .3 0"/>
    </body>
  </worldbody>

  <sensor>
    <framepos name="block_pos" objtype="geom" objname="block"/>
    <framequat name="block_quat" objtype="geom" objname="block"/>
    <framepos name="red_cube_pos" objtype="body" objname="red_cube"/>
    <framepos name="blue_part_pos" objtype="body" objname="blue_part"/>
    <framepos name="so101/ee_pos" objtype="site" objname="gripperframe"/>
    <framequat name="so101/ee_quat" objtype="site" objname="gripperframe"/>
    <framelinvel name="so101/ee_vel" objtype="site" objname="gripperframe"/>
    <frameangvel name="so101/ee_angvel" objtype="site" objname="gripperframe"/>
  </sensor>
</mujoco>
